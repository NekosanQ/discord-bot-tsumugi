DATABASE_URL=mysql://tsumugi:replace-with-database-password@mysql:3306/tsumugi
API_SERVICE_TOKEN=replace-with-the-same-random-value-as-bot-api-service-token
API_REDIS_URL=redis://redis-api-cache:6379
API_SECURITY_REDIS_URL=redis://redis-api-security:6379
API_DISCORD_CLIENT_ID=replace-with-discord-application-id
API_DISCORD_CLIENT_SECRET=replace-with-discord-oauth-client-secret
API_DISCORD_REDIRECT_URI=http://localhost:3001/auth/callback
# Generate each value independently with 32 random bytes encoded as base64.
API_SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-value
API_SESSION_SECRET=replace-with-another-32-byte-base64-value
API_WEB_PROXY_TOKEN=replace-with-a-random-value-of-at-least-32-characters
