{
    "name": "discord-bot-tsumugi",
    "version": "3.0.0",
    "private": true,
    "description": "「可愛くて、楽しい」DiscordBot monorepo",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "engines": {
        "node": "24.x",
        "npm": ">=10"
    },
    "scripts": {
        "start": "npm run start --workspace apps/bot",
        "dev": "npm run dev --workspace apps/bot",
        "compile": "npm run compile --workspace packages/contracts && npm run compile --workspace apps/api && npm run compile --workspace apps/bot",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "test:unit": "npm run test:unit --workspaces --if-present",
        "test:integration": "npm run test:integration --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "check:architecture": "eslint . --max-warnings=0",
        "check": "npm run compile --workspace packages/contracts && npm run lint:prettier && npm run check:architecture && npm run check --workspaces --if-present",
        "prisma:generate": "npm run prisma:generate --workspaces --if-present",
        "prisma:validate": "npm run prisma:validate --workspaces --if-present",
        "gemini": "gemini",
        "lint:prettier": "prettier --check --no-error-on-unmatched-pattern AGENTS.md README.md docs .github package.json eslint.config.js .devcontainer",
        "fix:prettier": "prettier --write --no-error-on-unmatched-pattern AGENTS.md README.md docs .github package.json eslint.config.js .devcontainer",
        "lint:eslint": "eslint . --max-warnings=0",
        "fix:eslint": "eslint . --fix"
    },
    "keywords": [],
    "author": "NekosanQ",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@google/gemini-cli": "^0.6.1",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^9.1.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "prettier": "^3.6.2",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.66.0"
    }
}
