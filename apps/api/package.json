{
    "name": "@tsumugi/api",
    "version": "3.0.0",
    "private": true,
    "description": "Tsumugi server management API",
    "type": "module",
    "main": "dist/index.js",
    "engines": {
        "node": "24.x",
        "npm": ">=10"
    },
    "scripts": {
        "start": "node dist/index.js",
        "build:contracts": "node ../../node_modules/typescript/bin/tsc -p ../../packages/contracts/tsconfig.build.json",
        "predev": "npm run build:contracts",
        "dev": "tsx src/index.ts",
        "compile": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "pretest:unit": "npm run build:contracts",
        "test:unit": "tsx --test \"tests/**/*.test.ts\"",
        "pretest:integration": "npm run build:contracts",
        "test:integration": "tsx --test --test-concurrency=1 \"integration-tests/**/*.test.ts\"",
        "test": "npm run test:unit && npm run test:integration",
        "prisma:generate": "prisma generate --schema prisma/schema.prisma",
        "prisma:validate": "prisma validate --schema prisma/schema.prisma",
        "check:architecture": "eslint src tests integration-tests --max-warnings=0 --no-error-on-unmatched-pattern",
        "check": "npm run lint:prettier && npm run check:architecture && npm run typecheck && npm run test:unit",
        "lint:prettier": "prettier --check --no-error-on-unmatched-pattern src tests integration-tests package.json \"tsconfig*.json\"",
        "fix:prettier": "prettier --write --no-error-on-unmatched-pattern src tests integration-tests package.json \"tsconfig*.json\""
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "@tsumugi/contracts": "1.0.0",
        "dotenv": "^16.4.5",
        "toml": "^3.0.0"
    },
    "devDependencies": {
        "prisma": "^6.19.3",
        "tsx": "^4.20.5"
    }
}
