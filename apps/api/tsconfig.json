{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "sourceMap": true,
        "noEmit": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "downlevelIteration": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "integration-tests/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
